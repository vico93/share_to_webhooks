[Unit]
Description=Share to Webhooks - Discord Webhook Media Sharing Service
After=network.target

[Service]
Type=simple
User=johndoe
WorkingDirectory=/home/johndoe/share_to_webhooks
ExecStart=/usr/bin/npm start

Restart=always
RestartSec=5

KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=10

Nice=-5
LimitNOFILE=65536
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target